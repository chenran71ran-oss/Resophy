FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
WORKDIR /app
ENV PYTHONPATH=/app
COPY requirements-research.txt ./
COPY LICENSE RESEARCH_LICENSES.md ./
COPY licenses ./licenses
RUN pip install --no-cache-dir -r requirements-research.txt
COPY resophy/core/base_paper.py resophy/core/base_paper.py
COPY resophy/core/__init__.py resophy/core/__init__.py
COPY resophy/research_api.py resophy/research_api.py
COPY resophy/annotation_store.py resophy/annotation_store.py
COPY resophy/annotation_service.py resophy/annotation_service.py
COPY resophy/annotation_routes.py resophy/annotation_routes.py
COPY resophy/research_archive.py resophy/research_archive.py
COPY resophy/research_collections.py resophy/research_collections.py
COPY resophy/research_store.py resophy/research_store.py
COPY resophy/research_providers.py resophy/research_providers.py
COPY resophy/research_usage.py resophy/research_usage.py
COPY resophy/research_parser.py resophy/research_parser.py
COPY resophy/research_cloud_parser.py resophy/research_cloud_parser.py
COPY resophy/research_worker.py resophy/research_worker.py
COPY resophy/babeldoc_runner.py resophy/babeldoc_runner.py
RUN useradd --uid 1000 --create-home research && mkdir /data && chown research /data
USER research
VOLUME /data
CMD ["gunicorn", "--bind", "0.0.0.0:8081", "--workers", "1", "--threads", "2", "--access-logfile", "-", "resophy.research_api:app"]
